{
  "manifest_version": 3,
  "name": "ChessLens \u2014 Chess.com Connector",
  "version": "1.3.0",
  "description": "Local Stockfish analysis, board markers and optional visual title badges. Never plays moves.",
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "http://127.0.0.1:37391/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "page-state.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "titles.js",
        "connector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chesslens@local.invalid",
      "strict_min_version": "140.0"
    }
  }
}
